NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<dbname>?appName=MERN

# Auth
JWT_SECRET=replace-with-a-strong-random-secret
TOTP_ISSUER=SecureChat
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Optional legacy server-side encryption key (E2EE no longer requires this)
CHAT_ENCRYPTION_KEY=replace-with-64-char-hex-key

# Google OAuth
GOOGLE_CLIENT_ID=google-client-id.apps.googleusercontent.com

# Twilio (optional - SMS/Verify)
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=twilio-auth-token
TWILIO_PHONE=+10000000000
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP (email OTP / notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Shadow Link <no-reply@example.com>
