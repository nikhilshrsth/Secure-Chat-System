# Root-level .env — consumed by docker-compose at build time for Vite build args.
# These values are baked into the React bundle at `docker-compose up --build`.
# After changing them you must rebuild the client image.

# Google OAuth client ID (same value as in src/server/.env)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Socket.IO endpoint — leave blank when Nginx proxies /socket.io/ to the server.
# Set to the full URL only if the client connects directly to the backend (no proxy).
VITE_SOCKET_URL=
